{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kevinbeier-hackathon-2026",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "kevinbeier-hackathon-2026-cache",
    },
  ],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kevinbeier-hackathon-2026",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"],
    },
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "kevinbeier-hackathon-2026-tags",
      "database_id": "482e2993-4fb9-4c2a-9dd2-9ce10e918daa",
    },
  ],
  "workers_dev": false,
  "preview_urls": false,
}
